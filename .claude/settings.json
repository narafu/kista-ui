{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /d/src/study/kista/kista-ui/.claude/hooks/block-env-local.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /d/src/study/kista/kista-ui/.claude/hooks/typecheck-ts-only.sh"
          }
        ]
      }
    ]
  }
}
